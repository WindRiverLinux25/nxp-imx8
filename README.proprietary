2.3 VPU test
------------

2.3.1 Requirements

Please use dtbs that support CSI, just like imx8qm-mek-ov5640-csi0.dtb.

Before using the VPU, we need to configure the media pipeline with media-ctl.
You can use the following script on target for quick setup.

1. To enable CSI0 with imx8qm-mek-ov5640-csi0.dtb:

$ cat << 'EOF' > ov5640_csi0.sh
#!/bin/sh -x

MDEV=${1:-1}
CAMERA="ov5640 2-003c"
W=1920
H=1080

media-ctl -d${MDEV} -r

media-ctl -d${MDEV} -R "'crossbar' [2/0 -> 6/0 [1]]"
media-ctl -d${MDEV} -l "'${CAMERA}':0 -> 'imx8mq-mipi-csi2 58227000.csi':0 [1]"
media-ctl -d${MDEV} -l "'crossbar':6 -> 'mxc_isi.0':0 [1]"
media-ctl -d${MDEV} -l "'mxc_isi.0':1 -> 'mxc_isi.0.capture':0 [1]"

media-ctl -d${MDEV} -V "'${CAMERA}':0 [fmt:UYVY/${W}x${H} field:none]"
media-ctl -d${MDEV} -V "'imx8mq-mipi-csi2 58227000.csi':0 [fmt:UYVY/${W}x${H} field:none]"
media-ctl -d${MDEV} -V "'crossbar':2 [fmt:UYVY/${W}x${H} field:none]"
media-ctl -d${MDEV} -V "'crossbar':6 [fmt:UYVY/${W}x${H} field:none]"
media-ctl -d${MDEV} -V "'mxc_isi.0':0 [compose:(0,0)/${W}x${H}]"
media-ctl -d${MDEV} -V "'mxc_isi.0':0 [fmt:UYVY/${W}x${H} field:none]"
media-ctl -d${MDEV} -V "'mxc_isi.0':1 [fmt:UYVY/${W}x${H} field:none]"

EOF

2. To enable CSI1 with imx8qm-mek-ov5640-csi1.dtb:

$ cat << 'EOF' > ov5640_csi1.sh
#!/bin/sh -x

MDEV=${1:-1}
CAMERA="ov5640 2-003c"
W=1920
H=1080

media-ctl -d${MDEV} -r

media-ctl -d${MDEV} -R "'crossbar' [3/0 -> 7/0 [1]]"
media-ctl -d${MDEV} -l "'${CAMERA}':0 -> 'imx8mq-mipi-csi2 58247000.csi':0 [1]"
media-ctl -d${MDEV} -l "'crossbar':7 -> 'mxc_isi.1':0 [1]"
media-ctl -d${MDEV} -l "'mxc_isi.1':1 -> 'mxc_isi.1.capture':0 [1]"

media-ctl -d${MDEV} -V "'${CAMERA}':0 [fmt:UYVY/${W}x${H} field:none]"
media-ctl -d${MDEV} -V "'imx8mq-mipi-csi2 58247000.csi':0 [fmt:UYVY/${W}x${H} field:none]"
media-ctl -d${MDEV} -V "'crossbar':3 [fmt:UYVY/${W}x${H} field:none]"
media-ctl -d${MDEV} -V "'crossbar':7 [fmt:UYVY/${W}x${H} field:none]"
media-ctl -d${MDEV} -V "'mxc_isi.1':0 [compose:(0,0)/${W}x${H}]"
media-ctl -d${MDEV} -V "'mxc_isi.1':0 [fmt:UYVY/${W}x${H} field:none]"
media-ctl -d${MDEV} -V "'mxc_isi.1':1 [fmt:UYVY/${W}x${H} field:none]"

EOF

2.3.2 Sample commands

    Note: Please refer to the '5. VPU firmware(MX8QM)' section to add the firmware.

    v4l2h264enc:
	gst-launch-1.0 v4l2src device=/dev/<capture device> num-buffers=300 ! video/x-raw,format=NV12,width=1920,height=1080,framerate=30/1 ! v4l2h264enc ! h264parse ! avimux ! filesink location=output.yuv

	You can find the correct capture device by checking Entity Info with v4l2-ctl.
	e.g.
	    $ v4l2-ctl -d /dev/video2 --all
	    ...
	    Entity Info:
		ID               : 0x00000013 (19)
		Name             : mxc_isi.0.capture
	    ...

    v4l2h264dec:
	gst-launch-1.0 filesrc location=sample-5s.mp4 ! qtdemux name=d d.video_0 ! queue ! h264parse ! v4l2h264dec ! imxvideoconvert_g2d ! queue ! waylandsink

    vp8dec:
	gst-launch-1.0 filesrc location=big-buck-bunny_trailer.webm ! matroskademux ! v4l2vp8dec ! imxvideoconvert_g2d ! queue ! waylandsink

    h265dec:
	gst-launch-1.0 filesrc location=1718886721_sample_1920x1080.hevc ! queue ! h265parse ! v4l2h265dec ! imxvideoconvert_g2d ! queue ! waylandsink


